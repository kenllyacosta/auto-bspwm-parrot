#!/usr/bin/env bash
set -eu
choice=$(printf 'Lock\nSleep\nLogout\nRestart\nShutdown\n' |
    rofi -theme "$HOME/.config/polybar/scripts/themes/powermenu_alt.rasi" -p System -dmenu) || exit 0
case "$choice" in
    Lock) i3lock --color=2e3440 ;;
    Sleep) loginctl lock-session; systemctl suspend ;;
    Logout) bspc quit ;;
    Restart) systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac